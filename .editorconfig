root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,jsx,ts,tsx,svelte,json,yml,yaml,css,scss,html}]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4

[*.{rs,toml}]
indent_style = space
indent_size = 4

[*.go]
indent_style = tab
indent_size = 4

[*.{sh,bash}]
indent_style = space
indent_size = 2

[*.sql]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
